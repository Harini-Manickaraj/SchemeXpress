# =============================================================
# SchemeXpress — Environment Variables Template
# =============================================================
# Copy this file to .env and fill in your actual values:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (macOS/Linux)
#
# NEVER commit the .env file. It is in .gitignore.
# This .env.example file IS committed — it shows collaborators
# which variables they need to configure, without exposing values.
# =============================================================

# ---------------------------------------------------------
# MongoDB Atlas Connection
# Get this from: MongoDB Atlas → Connect → Drivers → Python
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>
# ---------------------------------------------------------
MONGO_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/schemexpress

# ---------------------------------------------------------
# MongoDB Database Name
# This is the database SchemeXpress will use inside your Atlas cluster.
# ---------------------------------------------------------
MONGO_DB_NAME=schemexpress

# ---------------------------------------------------------
# Flask Configuration
# SECRET_KEY: Used by Flask to sign session cookies and CSRF tokens.
#             Generate a strong random key — never use a simple string in production.
#             Python command to generate one: python -c "import secrets; print(secrets.token_hex(32))"
# FLASK_ENV:  "development" enables debug mode. Use "production" when deploying.
# FLASK_DEBUG: 1 = on, 0 = off. MUST be 0 in production.
# ---------------------------------------------------------
FLASK_SECRET_KEY=replace-this-with-a-strong-random-secret-key
FLASK_ENV=development
FLASK_DEBUG=1

# ---------------------------------------------------------
# Application Settings
# ---------------------------------------------------------
# Number of recommendations to return per query
TOP_K_RECOMMENDATIONS=10

# Hybrid score weights (must sum to 1.0)
# These will be tuned during Phase 8-9 evaluation
ELIGIBILITY_WEIGHT=0.5
NLP_WEIGHT=0.5

# ---------------------------------------------------------
# RAG Assistant (Phase 14 — leave blank until needed)
# Uncomment and fill in when you reach Phase 14.
# ---------------------------------------------------------
# OPENAI_API_KEY=sk-your-openai-api-key-here
# EMBEDDING_MODEL=text-embedding-3-small
# RAG_TOP_K=5
