# .gitattributes
# Ensures consistent line endings across Windows/macOS/Linux.
# "text=auto" means Git normalizes line endings to LF in the repository
# and converts to the OS default on checkout.
# This prevents the "LF will be replaced by CRLF" noise on Windows.

* text=auto

# Explicitly mark Python and web files as text
*.py    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.env*  text eol=lf

# Binary files — Git should not try to diff or convert these
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pkl   binary
*.joblib binary
