# =============================================================
# SchemeXpress — .gitignore
# =============================================================
# This file tells Git which files and folders to NEVER track.
# Rule of thumb: if it's generated automatically, contains
# secrets, or is too large for GitHub — ignore it.
# =============================================================


# ---------------------------------------------------------
# Python virtual environments
# Never commit your venv — it's huge and machine-specific.
# Anyone cloning the repo recreates it with: pip install -r requirements.txt
# ---------------------------------------------------------
venv/
env/
.venv/
.env_backup/
ENV/


# ---------------------------------------------------------
# Environment variables — CRITICAL security rule
# This file will hold your MongoDB URI, API keys, etc.
# If you commit this, your credentials are public on GitHub.
# ---------------------------------------------------------
.env
.env.local
.env.production
*.env


# ---------------------------------------------------------
# Python bytecode and cache
# Python compiles .py files to .pyc for faster execution.
# These are auto-regenerated and don't belong in version control.
# ---------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd


# ---------------------------------------------------------
# Jupyter Notebook checkpoints
# Jupyter auto-saves checkpoints in .ipynb_checkpoints/
# These are not meaningful to version control.
# ---------------------------------------------------------
.ipynb_checkpoints/
*.ipynb_checkpoints


# ---------------------------------------------------------
# Data files — protect raw and large datasets
# Raw CSV/Excel files can be very large (Kaggle datasets).
# We document WHERE to get the data instead of committing it.
# Processed/small files can be committed if needed.
# ---------------------------------------------------------
data/raw/*.csv
data/raw/*.xlsx
data/raw/*.json
data/raw/*.zip
data/raw/*.gz

# Processed data — also exclude by default to keep repo light
# Remove a specific line below if you decide to commit a small processed file
data/processed/*.csv
data/processed/*.pkl
data/processed/*.parquet
data/interim/*.csv
data/interim/*.pkl


# ---------------------------------------------------------
# Model artifacts and large binary files
# Trained TF-IDF matrices, vector stores, embeddings, etc.
# These are regenerated by running the pipeline scripts.
# ---------------------------------------------------------
*.pkl
*.joblib
*.h5
*.model
*.bin
*.faiss
models/


# ---------------------------------------------------------
# Flask / Python web framework
# ---------------------------------------------------------
instance/
.webassets-cache
flask_session/


# ---------------------------------------------------------
# Operating system files
# These are generated by Windows/macOS/Linux file browsers
# and have nothing to do with the project.
# ---------------------------------------------------------
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~


# ---------------------------------------------------------
# IDE and editor files
# VS Code, PyCharm, etc. generate their own config folders.
# These are personal settings that don't belong in the repo.
# ---------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace


# ---------------------------------------------------------
# Testing and coverage
# ---------------------------------------------------------
.pytest_cache/
htmlcov/
.coverage
coverage.xml
*.cover


# ---------------------------------------------------------
# Distribution / packaging
# ---------------------------------------------------------
dist/
build/
*.egg-info/
*.egg
MANIFEST


# ---------------------------------------------------------
# Logs
# ---------------------------------------------------------
*.log
logs/


# ---------------------------------------------------------
# MongoDB local data (if running locally)
# ---------------------------------------------------------
mongodb_data/
